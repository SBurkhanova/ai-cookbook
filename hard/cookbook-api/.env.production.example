# Production environment for the AI Cookbook API (Challenge 7).
# In Azure App Service these become "Application settings" (NOT a committed file).
# Copy to .env.production for local prod-like runs; never commit real secrets.

# --- Server ---
PORT=4000
# App Service for Containers routes traffic to this port; set WEBSITES_PORT=4000
# as an application setting so the platform knows where to send requests.
NO_OPEN=1

# --- Claude API ---
# Leave empty to run in DEMO mode (deterministic sample recipes, no network).
# Set the real key as a SECRET application setting to enable live generation.
ANTHROPIC_API_KEY=

# --- Data stores (optional) ---
# Unset -> in-memory store/cache (fine for a demo deployment).
# Set to managed services for real persistence:
#   MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/cookbook
#   REDIS_URL=rediss://<host>:6380
MONGODB_URI=
REDIS_URL=

# --- CORS ---
# The browser origin allowed to call this API (e.g. your front-end URL).
# Leave empty if the API serves its own UI from the same origin.
CLIENT_ORIGIN=
